   "source": [
    "tab = (df.groupby(\"country\")\n",
    "         .agg(price=(\"price_eur\", \"mean\"), units_k=(\"sales_units_k\", \"mean\"),\n",
    "              promo=(\"promo_share\", \"mean\"))\n",
    "         .join(meta.set_index(\"country\")[[\"gdp_per_capita_eur_k\"]]))\n",
    "tab[\"price_per_gdp\"] = tab.price / tab.gdp_per_capita_eur_k * 1000\n",
    "tab.columns = [\"Avg price (EUR)\", \"Avg weekly units (k)\", \"Promo share\", \"GDP per head (k EUR)\", \"Price per 1 000 EUR GDP\"]\n",
    "tab.round(2)"
   ]
