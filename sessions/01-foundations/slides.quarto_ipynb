    "rows = []\n",
    "for c in COUNTRIES:\n",
    "    m = smf.ols(FULL, data=df[df.country == c]).fit()\n",
    "    ci = m.conf_int().loc[\"log_price\"]\n",
    "    rows.append({\"country\": c, \"elasticity\": m.params.log_price, \"lo\": ci[0], \"hi\": ci[1],\n",
    "                 \"promo\": m.params.promo_share, \"r2\": m.rsquared})\n",
    "el = pd.DataFrame(rows).set_index(\"country\")\n",
    "fig, ax = plt.subplots()\n",
    "ax.errorbar(el.index, el.elasticity, yerr=[el.elasticity - el.lo, el.hi - el.elasticity],\n",
    "            fmt=\"o\", capsize=5, color=\"tab:blue\", ecolor=\"tab:gray\")\n",
    "ax.axhline(-1, color=\"tab:red\", ls=\"--\", lw=1, label=\"unit elastic\")\n",
    "ax.set_ylabel(\"Price elasticity (95 % CI)\"); ax.set_xlabel(\"\")\n",
    "ax.set_title(\"Log-log model with promotion, holidays, Fourier seasonality and trend\")\n",
    "ax.legend(frameon=False); plt.tight_layout(); plt.show()"
   ]
