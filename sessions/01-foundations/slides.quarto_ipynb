   "source": [
    "fig, ax = plt.subplots()\n",
    "sc = ax.scatter(de.promo_share, de.price_eur, c=de.t, cmap=\"viridis\", s=16)\n",
    "ax.set_xlabel(\"Promotion share of volume\"); ax.set_ylabel(\"Average price (EUR)\")\n",
    "ax.set_title(\"Germany: price falls with promotion and rises over time\")\n",
    "cb = plt.colorbar(sc, ax=ax); cb.set_label(\"Week index (0 = Jan 2023)\")\n",
